# Local infra + MCP environment. Copy to .env (repo root, read by docker compose)
# and/or export for the scripts and agents. All optional — sensible defaults apply.

# ---- docker compose port overrides ----
KEYCLOAK_HTTP_PORT=8080
KEYCLOAK_MGMT_PORT=9000
PROMETHEUS_PORT=9090
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# ---- test realm objects (used by the scripts) ----
KEYCLOAK_REALM=sre-test
KEYCLOAK_CLIENT_ID=sre-test-client
KEYCLOAK_CLIENT_SECRET=sre-test-client-secret
KEYCLOAK_TEST_USER=sre-test-user
KEYCLOAK_TEST_PASSWORD=sre-test-password

# ---- local model ----
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# ---- Prometheus MCP (read-only), used by the Observability specialist ----
# Reference server is stdio; launch on the host pointed at the Dockerized Prometheus:
#   PROMETHEUS_URL=http://localhost:9090 uvx --from prometheus-mcp-server prometheus-mcp-server
PROMETHEUS_URL=http://localhost:9090
# If you instead front the MCP over HTTP, set this so verify-local-stack.sh can probe it:
# PROMETHEUS_MCP_ENDPOINT=http://localhost:8931

# ---- Keycloak MCP, used by the Keycloak specialist ----
# Point at YOUR existing local Keycloak MCP. If unset, its real test is BLOCKED (not faked).
# KEYCLOAK_MCP_ENDPOINT=
KEYCLOAK_URL=http://localhost:8080

# ---- Docker networking note ----
# Host component -> Docker service:  http://localhost:<port>
# Docker component -> host service:  http://host.docker.internal:<port>
