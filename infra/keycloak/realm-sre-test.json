{
  "realm": "sre-test",
  "enabled": true,
  "displayName": "SRE Test Realm",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "eventsEnabled": true,
  "eventsExpiration": 86400,
  "enabledEventTypes": [
    "LOGIN",
    "LOGIN_ERROR",
    "LOGOUT",
    "CODE_TO_TOKEN",
    "CODE_TO_TOKEN_ERROR",
    "REFRESH_TOKEN",
    "REFRESH_TOKEN_ERROR"
  ],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "bruteForceProtected": false,
  "roles": {
    "realm": [
      {
        "name": "sre-test-role",
        "description": "Test role used by the SRE PoC local environment"
      }
    ]
  },
  "clients": [
    {
      "clientId": "sre-test-client",
      "name": "SRE Test Client",
      "description": "Confidential client for local PoC token/login testing",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "sre-test-client-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "redirectUris": ["http://localhost:*", "https://localhost:*"],
      "webOrigins": ["*"],
      "defaultClientScopes": ["web-origins", "acr", "profile", "roles", "email"]
    },
    {
      "clientId": "sre-mcp-reader",
      "name": "SRE Keycloak MCP reader",
      "description": "Read-only service account for the Keycloak MCP (view-* realm-management roles only)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "sre-mcp-reader-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    {
      "username": "sre-test-user",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Sre",
      "lastName": "Tester",
      "email": "sre-test-user@sre.local",
      "credentials": [
        {
          "type": "password",
          "value": "sre-test-password",
          "temporary": false
        }
      ],
      "realmRoles": ["sre-test-role"]
    },
    {
      "username": "service-account-sre-mcp-reader",
      "enabled": true,
      "serviceAccountClientId": "sre-mcp-reader",
      "clientRoles": {
        "realm-management": [
          "view-realm",
          "view-users",
          "view-clients",
          "view-identity-providers",
          "view-authorization",
          "query-users",
          "query-clients",
          "query-groups"
        ]
      }
    }
  ]
}
