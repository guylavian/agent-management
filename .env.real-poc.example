# Copy to .env.real-poc. These are disposable local-PoC values only.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-this-local-admin-password
KEYCLOAK_REALM=sre-test
KEYCLOAK_CLIENT_ID=sre-test-client
KEYCLOAK_CLIENT_SECRET=change-this-local-client-secret
KEYCLOAK_TEST_USER=sre-test-user
KEYCLOAK_TEST_PASSWORD=change-this-local-user-password
KEYCLOAK_MCP_CLIENT_ID=sre-mcp-reader
KEYCLOAK_MCP_CLIENT_SECRET=change-this-local-mcp-reader-secret
SRE_WORKLOAD_CLIENT_ID=sre-manager-workload
SRE_WORKLOAD_CLIENT_SECRET=change-this-local-workload-secret

# Real OpenAI-compatible model endpoint. A local Ollama instance is acceptable.
SRE_LLM_BASE_URL=http://127.0.0.1:11434
SRE_MODEL_MANAGER=qwen3:8b
SRE_MODEL_TOOL_CALLER=qwen3:8b
SRE_MODEL_SYNTHESIS=qwen3:8b
# SRE_LLM_API_KEY=

# Existing real LLM Wiki MCP. start-real-poc.sh fails if it is unavailable.
LLM_WIKI_MCP_ENDPOINT=http://127.0.0.1:8642/mcp
