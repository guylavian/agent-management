# Site parameters for deploy/on-prem/argocd. No secrets here: the Bitbucket
# credential is an Argo CD repository Secret created out of band (INSTALL.md).
# Bitbucket Data Center clone URL: https://<host>/scm/<PROJECT>/<repo>.git
GIT_REPO_URL=https://bitbucket.example.internal/scm/sre/sre-agent-platform.git
GIT_REVISION=main
# must equal `namespace` in deploy/environments/production/environment.yaml
# (or the environmentOverride in runtime-values.yaml)
TARGET_NAMESPACE=sre-assistant
