{
  "realm": "sre-test",
  "enabled": true,
  "displayName": "SRE Test Realm",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "eventsEnabled": true,
  "eventsExpiration": 86400,
  "enabledEventTypes": [
    "LOGIN",
    "LOGIN_ERROR",
    "LOGOUT",
    "CODE_TO_TOKEN",
    "CODE_TO_TOKEN_ERROR",
    "REFRESH_TOKEN",
    "REFRESH_TOKEN_ERROR"
  ],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "bruteForceProtected": false,
  "roles": {
    "realm": [
      {
        "name": "sre-test-role",
        "description": "Test role used by the SRE PoC local environment"
      },
      {
        "name": "infra-read",
        "description": "Read-only SRE specialist entitlement"
      }
    ]
  },
  "clients": [
    {
      "clientId": "sre-test-client",
      "name": "SRE Test Client",
      "description": "Confidential client for local PoC token/login testing",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "sre-test-client-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "redirectUris": ["http://localhost:*", "https://localhost:*"],
      "webOrigins": ["*"],
      "defaultClientScopes": ["basic", "web-origins", "acr", "profile", "roles", "email"]
      ,
      "protocolMappers": [
        {
          "name": "sre-assistant-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "sre-assistant",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "realm-roles-flat",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "false",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "claim.name": "roles",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "clientId": "sre-mcp-reader",
      "name": "SRE Keycloak MCP reader",
      "description": "Read-only service account for the Keycloak MCP (view-* realm-management roles only)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "sre-mcp-reader-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "sre-manager-workload",
      "name": "SRE manager workload identity",
      "description": "Service identity for Manager to Specialist HTTP calls",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "sre-manager-workload-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "sre-agent-runtime-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "sre-agent-runtime",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "sre-test-user",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Sre",
      "lastName": "Tester",
      "email": "sre-test-user@sre.local",
      "credentials": [
        {
          "type": "password",
          "value": "sre-test-password",
          "temporary": false
        }
      ],
      "realmRoles": ["sre-test-role", "infra-read"]
    },
    {
      "username": "service-account-sre-mcp-reader",
      "enabled": true,
      "serviceAccountClientId": "sre-mcp-reader",
      "clientRoles": {
        "realm-management": [
          "view-realm",
          "view-users",
          "view-clients",
          "view-identity-providers",
          "view-authorization",
          "query-users",
          "query-clients",
          "query-groups"
        ]
      }
    },
    {
      "username": "service-account-sre-manager-workload",
      "enabled": true,
      "serviceAccountClientId": "sre-manager-workload"
    }
  ]
}
