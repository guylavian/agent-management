{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "sre.ai/v1alpha1"
    },
    "kind": {
      "type": "string",
      "const": "ModelBindings"
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "profiles": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "endpoint": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "provider",
          "model"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "environment",
    "profiles"
  ],
  "additionalProperties": false
}
