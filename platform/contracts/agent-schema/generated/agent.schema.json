{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "sre.ai/v1alpha1"
    },
    "kind": {
      "type": "string",
      "const": "Agent"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "avatar": {
          "type": "object",
          "properties": {
            "asset": {
              "type": "string",
              "pattern": "^assets\\/(agents|icons)\\/[a-z][a-z0-9-]*\\.(png|jpg|webp)$"
            },
            "fit": {
              "default": "contain",
              "type": "string",
              "enum": [
                "cover",
                "contain"
              ]
            }
          },
          "required": [
            "asset",
            "fit"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "owner"
      ],
      "additionalProperties": false
    },
    "spec": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "manager"
            },
            "lifecycle": {
              "default": "active",
              "type": "string",
              "enum": [
                "draft",
                "active",
                "disabled",
                "decommissioning",
                "removed"
              ]
            },
            "model": {
              "type": "object",
              "properties": {
                "tier": {
                  "type": "string",
                  "const": "small"
                },
                "profile": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "tier",
                "profile"
              ],
              "additionalProperties": false
            },
            "prompt": {
              "type": "object",
              "properties": {
                "systemFile": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "systemFile"
              ],
              "additionalProperties": false
            },
            "execution": {
              "type": "object",
              "properties": {
                "maxAgentsPerRequest": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 3
                },
                "maxRounds": {
                  "type": "number",
                  "const": 1
                },
                "timeoutMs": {
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 5000
                }
              },
              "required": [
                "maxAgentsPerRequest",
                "maxRounds",
                "timeoutMs"
              ],
              "additionalProperties": false
            },
            "output": {
              "type": "object",
              "properties": {
                "schema": {
                  "type": "string",
                  "const": "ManagerDecision"
                }
              },
              "required": [
                "schema"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "type",
            "lifecycle",
            "model",
            "prompt",
            "execution",
            "output"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "specialist"
            },
            "lifecycle": {
              "default": "active",
              "type": "string",
              "enum": [
                "draft",
                "active",
                "disabled",
                "decommissioning",
                "removed"
              ]
            },
            "model": {
              "type": "object",
              "properties": {
                "tier": {
                  "type": "string",
                  "enum": [
                    "small",
                    "large"
                  ]
                },
                "profile": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "tier",
                "profile"
              ],
              "additionalProperties": false
            },
            "prompt": {
              "type": "object",
              "properties": {
                "systemFile": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "systemFile"
              ],
              "additionalProperties": false
            },
            "identity": {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "const": "keycloak"
                },
                "clientId": {
                  "type": "string",
                  "pattern": "^sre-agent-[a-z][a-z0-9-]*$"
                }
              },
              "required": [
                "provider",
                "clientId"
              ],
              "additionalProperties": false
            },
            "environments": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "routing": {
              "default": {
                "capabilities": [],
                "exclusions": []
              },
              "type": "object",
              "properties": {
                "capabilities": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "exclusions": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "capabilities",
                "exclusions"
              ],
              "additionalProperties": false
            },
            "access": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "mcp": {
                    "type": "string",
                    "minLength": 1
                  },
                  "audience": {
                    "type": "string",
                    "minLength": 1
                  },
                  "tools": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": [
                  "mcp",
                  "tools"
                ],
                "additionalProperties": false
              }
            },
            "execution": {
              "type": "object",
              "properties": {
                "maxToolCalls": {
                  "default": 6,
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 20
                },
                "maxModelTurns": {
                  "default": 3,
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10
                },
                "timeoutMs": {
                  "default": 25000,
                  "type": "integer",
                  "minimum": 1000,
                  "maximum": 180000
                },
                "maxEvidenceBytes": {
                  "default": 262144,
                  "type": "integer",
                  "minimum": 4096,
                  "maximum": 4194304
                },
                "maxContextTokens": {
                  "default": 12000,
                  "type": "integer",
                  "minimum": 1000,
                  "maximum": 64000
                },
                "maxEvidenceItems": {
                  "default": 32,
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 128
                },
                "maxRawExcerptBytes": {
                  "default": 8192,
                  "type": "integer",
                  "minimum": 256,
                  "maximum": 65536
                }
              },
              "required": [
                "maxToolCalls",
                "maxModelTurns",
                "timeoutMs",
                "maxEvidenceBytes",
                "maxContextTokens",
                "maxEvidenceItems",
                "maxRawExcerptBytes"
              ],
              "additionalProperties": false
            },
            "discovery": {
              "type": "object",
              "properties": {
                "allowedNeedsDomains": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*$"
                  }
                }
              },
              "required": [
                "allowedNeedsDomains"
              ],
              "additionalProperties": false
            },
            "authorization": {
              "type": "object",
              "properties": {
                "requiredRoles": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "requiredRoles"
              ],
              "additionalProperties": false
            },
            "security": {
              "default": {
                "readOnly": true
              },
              "type": "object",
              "properties": {
                "readOnly": {
                  "type": "boolean",
                  "const": true
                }
              },
              "required": [
                "readOnly"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "type",
            "lifecycle",
            "model",
            "prompt",
            "identity",
            "environments",
            "routing",
            "access",
            "execution",
            "authorization",
            "security"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "additionalProperties": false
}
