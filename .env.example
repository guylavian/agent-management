# Copy to .env.local for npm run dev:local. Every client defaults to mock.
SRE_ENV=local
SRE_PORT=3000
# selects the logical agent this process runs (manager or one specialist)
AGENT_CONFIG=agents/manager.yaml
SRE_AGENT_REGISTRY=agents/registry.yaml
SRE_CLIENT_OIDC=mock
SRE_CLIENT_LLM=mock
SRE_CLIENT_TOOLHIVE=mock
SRE_CLIENT_RAG=mock
SRE_CLIENT_POSTGRES=mock
# manager -> specialist transport and delegated-identity signing
SRE_CLIENT_AGENT=mock
SRE_CLIENT_DELEGATION=mock
SRE_OTEL_EXPORTER=console
